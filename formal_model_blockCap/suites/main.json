{
  "model": "models/blockcap_final.als",
  "out": "results_final/main",
  "scopes": {
    "main": "for 4 Node, 2 Policy, 4 Slot, 2 Op, 2 Role, 2 Res, 2 Principal, 4 Int, 1..7 steps",
    "small": "for 4 Node, 2 Policy, 3 Slot, 2 Op, 2 Role, 2 Res, 2 Principal, 4 Int, 1..5 steps"
  },
  "default_timeout": 1800,
  "jobs": [
    {
      "name": "Reach_DelegationChainDepth2",
      "kind": "run",
      "expect": "reachable",
      "scope": "main"
    },
    {
      "name": "Reach_RevokedParentWithLiveChild",
      "kind": "run",
      "expect": "reachable",
      "scope": "main"
    },
    {
      "name": "Reach_RoleMismatchDelegation",
      "kind": "run",
      "expect": "reachable",
      "scope": "main"
    },
    {
      "name": "Rich_AllMechanismsInOneTrace",
      "kind": "run",
      "expect": "reachable",
      "scope": "main"
    },
    {
      "name": "Reach_DelegationChainDepth2",
      "kind": "run",
      "expect": "reachable",
      "scope": "small",
      "label": "Reach_DelegationChainDepth2_small"
    },
    {
      "name": "Reach_ParentReissuedAfterLapse",
      "kind": "run",
      "expect": "reachable",
      "scope": "small"
    },
    {
      "name": "P1_TokenUniqueness",
      "kind": "check",
      "expect": "holds",
      "scope": "main"
    },
    {
      "name": "P2_StoredState",
      "kind": "check",
      "expect": "fails",
      "scope": "main"
    },
    {
      "name": "P3_AuthCorrectness",
      "kind": "check",
      "expect": "holds",
      "scope": "main"
    },
    {
      "name": "R_Revocation",
      "kind": "check",
      "expect": "holds",
      "scope": "main"
    },
    {
      "name": "R1_RootTokensMatchPolicyRoles",
      "kind": "check",
      "expect": "holds",
      "scope": "main"
    },
    {
      "name": "R2_DelegatedTokensMatchPolicyRoles",
      "kind": "check",
      "expect": "fails",
      "scope": "main"
    },
    {
      "name": "P2_AtDerivation",
      "kind": "check",
      "expect": "holds",
      "scope": "small"
    },
    {
      "name": "P2_EvaluatedChain",
      "kind": "check",
      "expect": "holds",
      "scope": "small",
      "timeout": 3600
    },
    {
      "name": "R_ReissueOutcome",
      "kind": "check",
      "expect": "holds",
      "scope": "small",
      "timeout": 3600
    },
    {
      "name": "WalkExpiryRedundant",
      "kind": "check",
      "expect": "holds",
      "scope": "small"
    },
    {
      "name": "F2_OpsNeverGrowWithinGeneration",
      "kind": "check",
      "expect": "holds",
      "scope": "small"
    },
    {
      "name": "A1_NonDelegationChangesOnlyByObjectOwner",
      "kind": "check",
      "expect": "holds",
      "scope": "small"
    },
    {
      "name": "A2_DelegationOnlyByParentHolder",
      "kind": "check",
      "expect": "holds",
      "scope": "small"
    },
    {
      "name": "A3_RevocationOnlyByObjectOwner",
      "kind": "check",
      "expect": "holds",
      "scope": "small"
    },
    {
      "name": "A4_NoUnattributedChange",
      "kind": "check",
      "expect": "holds",
      "scope": "small"
    }
  ]
}
      "name": "STEP_C1_PolicyNarrowingImmediate",
      "kind": "check",
      "expect": "holds",
      "scope": "anystate"
    },
    {
      "name": "STEP_C2_DeprecationImmediate",
      "kind": "check",
      "expect": "holds",
      "scope": "anystate"
    },
    {
      "name": "STEP_C3_AdjustRetainsParent",
      "kind": "check",
      "expect": "holds",
      "scope": "anystate"
    },
    {
      "name": "STEP_C4_AdjustExpiryForward",
      "kind": "check",
      "expect": "holds",
      "scope": "anystate"
    },
    {
      "name": "STEP_C5_AdjustDepthNotIncreased",
      "kind": "check",
      "expect": "holds",
      "scope": "anystate"
    },
    {
      "name": "STEP_C6_AdjustNotBeyondParent",
      "kind": "check",
      "expect": "holds",
      "scope": "anystate"
    },
    {
      "name": "STEP_C7_DelegationCopiesDlg",
      "kind": "check",
      "expect": "holds",
      "scope": "anystate"
    }
  ]
}